
@using ClassMate.Data

<div class="card mb-2 p-3"
     style="@($"border-left: 5px solid {Course.Color}")">

    <div class="d-flex justify-content-between align-items-start">

        <div>
            <h5>@Course.Name</h5>
            <p class="mb-1">@Course.Code</p>
            <p class="mb-0">@Course.Instructor</p>
        </div>

        @if (Course.IsArchived)
        {
            <div class="d-flex flex-column align-items-end gap-2">
                <span class="badge bg-secondary">
                    @Course.Semester @Course.Year
                </span>

                <button type="button"
                        class="btn btn-outline-success btn-sm"
                        @onclick="() => OnRestore.InvokeAsync(Course.Id)">
                    Restore
                </button>
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-items-end gap-2">

                <span class="badge bg-secondary">
                    @Course.Semester @Course.Year
                </span>

                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        @onclick="() => OnEdit.InvokeAsync(Course)">
                    Edit
                </button>

                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        @onclick="() => OnDeleteRequested.InvokeAsync(Course.Id)">
                    Delete
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="() => OnArchive.InvokeAsync(Course.Id)">
                    Archive
                </button>

            </div>
        }
    </div>

    @if (IsDeletePending && !Course.IsArchived)
    {
        <div class="alert alert-warning mt-3">
            <p>
                Are you sure you want to delete
                <strong>@Course.Name</strong>?
            </p>

            <p>
                Related assignments, notes, and study
                sessions will also be deleted.
            </p>

            <button type="button"
                    class="btn btn-danger me-2"
                    @onclick="() => OnDeleteConfirmed.InvokeAsync(Course.Id)">
                Yes, Delete
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="() => OnDeleteCanceled.InvokeAsync()">
                Cancel
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Course Course { get; set; } = default!;

    [Parameter]
    public bool IsDeletePending { get; set; }

    [Parameter]
    public EventCallback<Course> OnEdit { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleteRequested { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleteConfirmed { get; set; }

    [Parameter]
    public EventCallback OnDeleteCanceled { get; set; }

    [Parameter]
    public EventCallback<int> OnArchive { get; set; }

    [Parameter]
    public EventCallback<int> OnRestore { get; set; }
}
