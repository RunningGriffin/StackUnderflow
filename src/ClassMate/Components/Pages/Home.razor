@page "/"

<PageTitle>ClassMate</PageTitle>

<h1>Welcome to ClassMate</h1>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
    </Authorized>
    <NotAuthorized>
        <p>Keep track of your courses, assignments, notes and study time in one place.</p>
        <a class="btn btn-primary me-2" href="Account/Register">Sign up</a>
        <a class="btn btn-outline-primary" href="Account/Login">Log in</a>
    </NotAuthorized>
</AuthorizeView>
