
@page "/settings"
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ClassMate.Services.ReminderService Reminders
@inject ILogger<Settings> Logger

<PageTitle>Settings · ClassMate</PageTitle>

<h1>Settings</h1>

<h2 class="h4">Reminders</h2>

@if (loadFailed)
{
    <p class="text-danger" role="alert">Your settings couldn't be loaded. Refresh the page to try again</p>
}
else if (!loaded)
{
    <p role="status">Loading settings…</p>
}
else
{
    <form @onsubmit="SaveAsync">
        <fieldset disabled="@isBusy">
            <div class="mb-3">
                <label for="lead-time" class="form-label">
                    Remind me before assignments are due and study sessions start
                </label>
                <select id="lead-time" class="form-select w-auto" @bind="leadHours">
                    @foreach (var hours in options)
                    {
                        <option value="@hours">@ClassMate.Services.ReminderService.DescribeLead(hours) before</option>
                    }
                </select>
                <div class="form-text">
                    Assignments only have a due date, so they count as due at the end of that day.
                    Completed assignments never trigger reminders.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save settings</button>
        </fieldset>
    </form>

    @* Always rendered so screen readers announce text changes inside it. *@
    <p class="mt-2" role="status">@message</p>
}

@code {
    private static readonly int[] StandardOptions = [1, 3, 24, 48];

    private int leadHours;
    private List<int> options = [];
    private bool loaded;
    private bool loadFailed;
    private bool isBusy;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = (int)Math.Round(await Reminders.GetLeadHoursAsync());

            leadHours = saved;
            options = StandardOptions.ToList();

            if (!options.Contains(saved))
            {
                options.Add(saved);
                options.Sort();
            }

            loaded = true;
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not load the reminder setting");
            loadFailed = true;
        }
    }

    private async Task SaveAsync()
    {
        if (isBusy)
            return;

        isBusy = true;
        message = "";

        try
        {
            await Reminders.SaveLeadHoursAsync(leadHours);

            message = $"Saved. Reminders will show up to {ClassMate.Services.ReminderService.DescribeLead(leadHours)} before something is due";
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException)
        {
            Logger.LogError(ex, "Could not save the reminder setting");
            message = "Your settings couldn't be saved. Please try again";
        }
        finally
        {
            isBusy = false;
        }
    }
}