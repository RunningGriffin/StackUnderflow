@page "/assignments"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using ClassMate.Data
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject ClassMate.Services.CurrentUser CurrentUser
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>My Assignments</PageTitle>

<h1>My Assignments</h1>
<h2 class="h4">@(draft.Id == 0 ? "New Assignment" : "Edit Assignment")</h2>

<EditForm Model="draft" OnValidSubmit="SaveAssignmentAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset disabled="@isBusy">
        <div class="mb-3">
            <label for="course" class="form-label">Course</label>
            <InputSelect TValue="int" id="course" class="form-select"
                         @bind-Value="draft.CourseId">
                <option value="0">Select a course</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id">@course.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="title" class="form-label">Assignment title</label>
            <InputText id="title" class="form-control"
                       @bind-Value="draft.Title" />
        </div>

        <div class="mb-3">
            <label for="due-date" class="form-label">Due date</label>
            <InputDate id="due-date" class="form-control"
                       @bind-Value="draft.DueDate" />
        </div>

        <div class="mb-3">
            <label for="priority" class="form-label">Priority</label>
            <InputSelect id="priority" class="form-select"
                         @bind-Value="draft.Priority">
                <option value="@Priority.Low">Low</option>
                <option value="@Priority.Medium">Medium</option>
                <option value="@Priority.High">High</option>
            </InputSelect>
        </div>

        <PriorityBadge Priority="@draft.Priority" />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                @(draft.Id == 0 ? "Save Assignment" : "Save Changes")
            </button>

            @if (draft.Id != 0)
            {
                <button type="button" class="btn btn-outline-secondary ms-2"
                        @onclick="CancelEdit">
                    Cancel
                </button>
            }
        </div>
    </fieldset>

    @if (!string.IsNullOrEmpty(formMessage))
    {
        <p class="mt-2" role="status">@formMessage</p>
    }
</EditForm>

<h2 class="h4 mt-4">Saved Assignments</h2>

@if (savedAssignments.Count == 0)
{
    <p>You haven't saved any assignments yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in savedAssignments)
        {
            <li class="list-group-item" @key="item.Id">
                <strong>@item.Title</strong>
                <div>
                    @item.Course.Name · Due @item.DueDate.ToString("MMM d, yyyy")
                </div>

                <PriorityBadge Priority="@item.Priority" />

                <button type="button" class="btn btn-sm btn-outline-primary ms-2"
                        disabled="@isBusy" @onclick="() => StartEdit(item)">
                    Edit
                </button>

                @if (pendingDeleteId == item.Id)
                {
                    <div class="mt-2">
                        <span>Delete “@item.Title”?</span>

                        <button type="button" class="btn btn-sm btn-danger ms-2"
                                disabled="@isBusy"
                                @onclick="() => DeleteAssignmentAsync(item)">
                            Confirm delete
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2"
                                disabled="@isBusy"
                                @onclick="() => pendingDeleteId = null">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                            disabled="@isBusy"
                            @onclick="() => pendingDeleteId = item.Id">
                        Delete
                    </button>
                }
            </li>
        }
    </ul>
}

@code {
    private AssignmentDraft draft = new();
    private List<Course> courses = new();
    private List<Assignment> savedAssignments = new();
    private int? pendingDeleteId;
    private string formMessage = "";
    private bool isBusy;

    private sealed class AssignmentDraft
    {
        public int Id { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Choose a course.")]
        public int CourseId { get; set; }

        [Required(ErrorMessage = "Enter an assignment title.")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "Choose a due date.")]
        public DateTime? DueDate { get; set; } = DateTime.Today;

        public Priority Priority { get; set; } = Priority.Medium;
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetRequiredUserIdAsync();

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        courses = await db.Courses
            .AsNoTracking()
            .Where(course => course.UserId == userId)
            .OrderBy(course => course.Name)
            .ToListAsync();

        savedAssignments = await LoadAssignmentsAsync(db, userId);
    }

    private Task<List<Assignment>> LoadAssignmentsAsync(
        ApplicationDbContext db, string userId)
    {
        return db.Assignments
            .AsNoTracking()
            .Include(item => item.Course)
            .Where(item => item.UserId == userId)
            .OrderBy(item => item.DueDate)
            .ThenBy(item => item.Title)
            .ThenBy(item => item.Id)
            .ToListAsync();
    }

    private void StartEdit(Assignment item)
    {
        pendingDeleteId = null;

        // Keep edits in a draft so Cancel can discard them
        draft = new AssignmentDraft
        {
            Id = item.Id,
            CourseId = item.CourseId,
            Title = item.Title,
            DueDate = item.DueDate,
            Priority = item.Priority
        };

        formMessage = "";
    }

    private void CancelEdit()
    {
        draft = new AssignmentDraft { CourseId = draft.CourseId };
        formMessage = "";
    }

    private async Task SaveAssignmentAsync()
    {
        if (isBusy)
            return;

        if (draft.DueDate is not DateTime dueDate)
            return;

        isBusy = true;
        formMessage = "";

        try
        {
            var userId = await CurrentUser.GetRequiredUserIdAsync();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var ownsCourse = await db.Courses.AnyAsync(course =>
                course.Id == draft.CourseId && course.UserId == userId);

            if (!ownsCourse)
            {
                formMessage = "Choose a course that belongs to your account.";
                return;
            }

            Assignment assignment;
            bool isNew = draft.Id == 0;

            if (isNew)
            {
                assignment = new Assignment { UserId = userId };
                db.Assignments.Add(assignment);
            }
            else
            {
                var existing = await db.Assignments.SingleOrDefaultAsync(item =>
                    item.Id == draft.Id && item.UserId == userId);

                if (existing is null)
                {
                    formMessage = "This assignment is no longer available. Refresh the page.";
                    return;
                }

                assignment = existing;
            }

            assignment.CourseId = draft.CourseId;
            assignment.Title = draft.Title.Trim();
            assignment.DueDate = dueDate;
            assignment.Priority = draft.Priority;

            await db.SaveChangesAsync();

            draft = new AssignmentDraft { CourseId = assignment.CourseId };
            formMessage = isNew
                ? $"Saved “{assignment.Title}”."
                : $"Updated “{assignment.Title}”.";

            savedAssignments = await LoadAssignmentsAsync(db, userId);
        }
        catch (DbUpdateException)
        {
            formMessage = "The assignment couldn't be saved. Check the course and try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAssignmentAsync(Assignment item)
    {
        if (isBusy || pendingDeleteId != item.Id)
            return;

        isBusy = true;

        try
        {
            var userId = await CurrentUser.GetRequiredUserIdAsync();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var deleted = await db.Assignments
                .Where(assignment => assignment.Id == item.Id &&
                                     assignment.UserId == userId)
                .ExecuteDeleteAsync();

            if (draft.Id == item.Id)
                CancelEdit();

            pendingDeleteId = null;
            savedAssignments.Remove(item);

            formMessage = deleted == 1
                ? $"Deleted “{item.Title}”."
                : "This assignment is no longer available.";
        }
        catch (DbException)
        {
            formMessage = "The assignment couldn't be deleted. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }
}