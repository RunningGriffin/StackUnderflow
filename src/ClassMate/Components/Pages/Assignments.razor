@page "/assignments"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using ClassMate.Data
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject ClassMate.Services.CurrentUser CurrentUser
@inject ClassMate.Services.UserClock Clock
@inject ILogger<Assignments> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>My Assignments</PageTitle>

<h1>My Assignments</h1>
<h2 class="h4">@(draft.IsNew ? "New Assignment" : "Edit Assignment")</h2>

<EditForm Model="draft" OnValidSubmit="SaveAssignmentAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset disabled="@isBusy">
        <div class="mb-3">
            <label for="course" class="form-label">Course</label>
            <InputSelect TValue="int" id="course" class="form-select"
                         @bind-Value="draft.CourseId">
                <option value="0">Select a course</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id">@course.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="title" class="form-label">Assignment title</label>
            <InputText @ref="titleInput" id="title" class="form-control"
                       @bind-Value="draft.Title" />
        </div>

        <div class="mb-3">
            <label for="due-date" class="form-label">Due date</label>
            <InputDate id="due-date" class="form-control"
                       @bind-Value="draft.DueDate" />

            @if (draft.IsNew && HasPastDueDate)
            {
                <p class="form-text text-warning-emphasis" role="status">
                    This due date has already passed. You can still save the assignment,
                    and it will appear as overdue.
                </p>
            }
        </div>

        <div class="mb-3">
            <label for="priority" class="form-label">Priority</label>
            <InputSelect id="priority" class="form-select"
                         @bind-Value="draft.Priority">
                <option value="@Priority.Low">Low</option>
                <option value="@Priority.Medium">Medium</option>
                <option value="@Priority.High">High</option>
            </InputSelect>
        </div>

        <PriorityBadge Priority="@draft.Priority" />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                @(draft.IsNew ? "Save Assignment" : "Save Changes")
            </button>

            @if (!draft.IsNew)
            {
                <button type="button" class="btn btn-outline-secondary ms-2"
                        @onclick="CancelEdit">
                    Cancel
                </button>
            }
        </div>
    </fieldset>

    @* Always rendered so screen readers announce text changes inside it *@
    <p class="mt-2" role="status">@formMessage</p>
</EditForm>

<h2 class="h4 mt-4">Saved Assignments</h2>

@if (savedAssignments.Count == 0)
{
    <p>You haven't saved any assignments yet</p>
}
else
{
    <div class="mb-3">
        <label for="assignment-sort" class="form-label">Sort assignments by</label>
        <select id="assignment-sort" class="form-select w-auto" @bind="assignmentSort">
            <option value="@AssignmentSort.DueDate">Due date</option>
            <option value="@AssignmentSort.Priority">Priority</option>
        </select>
    </div>

    var today = Clock.Today;

    <ul class="list-group">
        @foreach (var item in SortedAssignments)
        {
            var isOverdue = !item.Completed && item.DueDate.Date < today;

            <li class="list-group-item @(isOverdue ? "list-group-item-danger" : "")" @key="item.Id">
                <strong>@item.Title</strong>
                <div>
                    @item.Course.Name · Due @item.DueDate.ToString("MMM d, yyyy")
                </div>

                <PriorityBadge Priority="@item.Priority" />

                @if (item.Completed)
                {
                    <span class="badge text-bg-success ms-1">Complete</span>
                }
                else if (isOverdue)
                {
                    <span class="badge text-bg-danger ms-1">Overdue</span>
                }

                <button type="button" class="btn btn-sm btn-outline-secondary ms-2"
                        disabled="@isBusy"
                        @onclick="() => SetCompletionAsync(item, !item.Completed)">
                    @(item.Completed ? "Mark incomplete" : "Mark complete")
                    <span class="visually-hidden">: @item.Title</span>
                </button>

                <button type="button" class="btn btn-sm btn-outline-primary ms-2"
                        disabled="@isBusy" @onclick="() => StartEdit(item)">
                    Edit
                    <span class="visually-hidden">@item.Title</span>
                </button>

                @if (pendingDeleteId == item.Id)
                {
                    <div class="mt-2">
                        <span>Delete “@item.Title”?</span>

                        <button type="button" class="btn btn-sm btn-danger ms-2"
                                disabled="@isBusy"
                                @onclick="() => DeleteAssignmentAsync(item)">
                            Confirm delete
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2"
                                disabled="@isBusy"
                                @onclick="() => pendingDeleteId = null">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                            disabled="@isBusy" @onclick="() => pendingDeleteId = item.Id">
                        Delete
                        <span class="visually-hidden">@item.Title</span>
                    </button>
                }
            </li>
        }
    </ul>
}

@code {
    private AssignmentDraft draft = new();
    private List<Course> courses = new();
    private List<Assignment> savedAssignments = new();
    private int? pendingDeleteId;
    private string formMessage = "";
    private bool isBusy;
    private AssignmentSort assignmentSort;
    private InputText? titleInput;
    private bool focusTitleAfterRender;

    private enum AssignmentSort
    {
        DueDate,
        Priority
    }

    // The query orders by due date, then title, then id. OrderBy is a
    // stable sort, so ties on priority keep that order. The Priority enum is
    // declared High, Medium, Low
    private IEnumerable<Assignment> SortedAssignments => assignmentSort == AssignmentSort.Priority
        ? savedAssignments.OrderBy(item => item.Priority)
        : savedAssignments;

    private bool HasPastDueDate =>
        draft.DueDate is DateTime date && date.Date < Clock.Today;

    private sealed class AssignmentDraft
    {
        public int Id { get; set; }

        public bool IsNew => Id == 0;

        [Range(1, int.MaxValue, ErrorMessage = "Choose a course.")]
        public int CourseId { get; set; }

        [Required(ErrorMessage = "Enter an assignment title.")]
        [StringLength(200, ErrorMessage = "Keep the title under 200 characters")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "Choose a due date.")]
        public DateTime? DueDate { get; set; }

        public Priority Priority { get; set; } = Priority.Medium;
    }

    private AssignmentDraft NewDraft(int courseId = 0) => new()
    {
        CourseId = courseId,
        DueDate = Clock.Today
    };

    protected override async Task OnInitializedAsync()
    {
        draft = NewDraft();

        var userId = await CurrentUser.GetRequiredUserIdAsync();

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        courses = await db.Courses
            .AsNoTracking()
            .Where(course => course.UserId == userId)
            .OrderBy(course => course.Name)
            .ToListAsync();

        savedAssignments = await LoadAssignmentsAsync(db, userId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // browser's time zone is read here, once the circuit is connected.
            await Clock.InitializeAsync();

            if (draft.IsNew && string.IsNullOrEmpty(draft.Title))
                draft.DueDate = Clock.Today;

            StateHasChanged();
        }

        if (focusTitleAfterRender && titleInput?.Element is { } element)
        {
            focusTitleAfterRender = false;
            await element.FocusAsync();
        }
    }

    private Task<List<Assignment>> LoadAssignmentsAsync(
        ApplicationDbContext db, string userId)
    {
        return db.Assignments
            .AsNoTracking()
            .Include(item => item.Course)
            .Where(item => item.UserId == userId)
            .OrderBy(item => item.DueDate)
            .ThenBy(item => item.Title)
            .ThenBy(item => item.Id)
            .ToListAsync();
    }

    private void StartEdit(Assignment item)
    {
        pendingDeleteId = null;

        // Keep edits in a draft so Cancel can discard them
        draft = new AssignmentDraft
        {
            Id = item.Id,
            CourseId = item.CourseId,
            Title = item.Title,
            DueDate = item.DueDate,
            Priority = item.Priority
        };

        formMessage = "";
        focusTitleAfterRender = true;
    }

    private void CancelEdit()
    {
        draft = NewDraft(draft.CourseId);
        formMessage = "";
    }

    private async Task SaveAssignmentAsync()
    {
        if (isBusy)
            return;

        if (draft.DueDate is not DateTime dueDate)
            return;

        isBusy = true;
        formMessage = "";

        try
        {
            var userId = await CurrentUser.GetRequiredUserIdAsync();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var ownsCourse = await db.Courses.AnyAsync(course =>
                course.Id == draft.CourseId && course.UserId == userId);

            if (!ownsCourse)
            {
                formMessage = "Choose a course that belongs to your account.";
                return;
            }

            Assignment assignment;
            bool isNew = draft.IsNew;

            if (isNew)
            {
                assignment = new Assignment { UserId = userId };
                db.Assignments.Add(assignment);
            }
            else
            {
                var existing = await db.Assignments.SingleOrDefaultAsync(item =>
                    item.Id == draft.Id && item.UserId == userId);

                if (existing is null)
                {
                    formMessage = "This assignment is no longer available. Refresh the page.";
                    return;
                }

                assignment = existing;
            }

            assignment.CourseId = draft.CourseId;
            assignment.Title = draft.Title.Trim();
            assignment.DueDate = dueDate;
            assignment.Priority = draft.Priority;

            await db.SaveChangesAsync();

            draft = NewDraft(assignment.CourseId);
            formMessage = isNew
                ? $"Saved “{assignment.Title}”."
                : $"Updated “{assignment.Title}”.";

            // The save has succeeded so a failed refresh gets its own message failed message
            try
            {
                savedAssignments = await LoadAssignmentsAsync(db, userId);
            }
            catch (DbException ex)
            {
                Logger.LogError(ex, "Assignment {AssignmentId} saved but the list could not be reloaded", assignment.Id);
                formMessage += " The list couldn't be refreshed, so reload the page to see it";
            }
        }
        catch (Exception ex) when (ex is DbUpdateException or DbException)
        {
            Logger.LogError(ex, "Could not save assignment {AssignmentId}", draft.Id);
            formMessage = "The assignment couldn't be saved. Check the course and try again";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SetCompletionAsync(Assignment item, bool completed)
    {
        if (isBusy)
            return;

        isBusy = true;
        formMessage = "";

        try
        {
            var userId = await CurrentUser.GetRequiredUserIdAsync();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var updated = await db.Assignments
                .Where(assignment => assignment.Id == item.Id && assignment.UserId == userId)
                .ExecuteUpdateAsync(setters => setters.SetProperty(assignment => assignment.Completed, completed));

            if (updated == 0)
            {
                formMessage = "This assignment is no longer available. Refresh the page.";
                return;
            }

            item.Completed = completed;

            formMessage = completed
                ? $"Marked “{item.Title}” complete."
                : $"Marked “{item.Title}” incomplete.";
        }
        catch (DbException ex)
        {
            Logger.LogError(ex, "Could not update completion for assignment {AssignmentId}", item.Id);
            formMessage = "The assignment status couldn't be saved. Please try again";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAssignmentAsync(Assignment item)
    {
        if (isBusy || pendingDeleteId != item.Id)
            return;

        isBusy = true;
        formMessage = "";

        try
        {
            var userId = await CurrentUser.GetRequiredUserIdAsync();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var deleted = await db.Assignments
                .Where(assignment => assignment.Id == item.Id &&
                                     assignment.UserId == userId)
                .ExecuteDeleteAsync();

            if (draft.Id == item.Id)
                CancelEdit();

            pendingDeleteId = null;
            savedAssignments.Remove(item);

            formMessage = deleted == 1
                ? $"Deleted “{item.Title}”."
                : "This assignment is no longer available.";
        }
        catch (DbException ex)
        {
            Logger.LogError(ex, "Could not delete assignment {AssignmentId}", item.Id);
            formMessage = "The assignment couldn't be deleted. Please try again";
        }
        finally
        {
            isBusy = false;
        }
    }
}