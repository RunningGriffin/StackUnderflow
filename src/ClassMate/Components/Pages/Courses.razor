
@page "/courses"
@using ClassMate.Data

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using ClassMate.Components.Courses

@attribute [Authorize]

@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthStateProvider

@inject ClassMate.Services.CourseService CourseService



<PageTitle>My Courses</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>My Courses</h1>
        <p>Manage your courses for this semester.</p>
    </div>

    <button type="button"
            class="btn btn-primary rounded-circle"
            style="width: 44px; height: 44px;"
            title="@(showForm ? "Cancel" : "Add Course")"
            aria-label="@(showForm ? "Cancel" : "Add Course")"
            @onclick="ToggleForm">
        @(showForm ? "×" : "+")
    </button>
</div>


@if (showForm)
{
    <CourseForm
        CourseModel="@newCourse"
        IsEditing="@(editingCourseId.HasValue)"
        ErrorMessage="@errorMessage"
        OnSave="SaveCourse" />
}


<h3 class="mt-4">Active Courses</h3>

 
@if (!string.IsNullOrEmpty(deleteError))
{
    //this makes it possible to display errors
    <p class="text-danger" role="alert">@deleteError</p>
}


@foreach (var course in courses.Where(c => !c.IsArchived))
{
    <CourseCard
        @key="course.Id"
        Course="course"
        IsDeletePending="@(pendingDeleteId == course.Id)"
        OnEdit="EditCourse"
        OnDeleteRequested="AskToDelete"
        OnDeleteConfirmed="DeleteCourse"
        OnDeleteCanceled="CancelDelete"
        OnArchive="ArchiveCourse" />
}




<div class="d-flex justify-content-between align-items-center mt-5 mb-3">

    <h3 class="mb-0">Archived Courses</h3>

    <button type="button"
            class="btn btn-outline-secondary"
            @onclick="ToggleArchivedCourses"
            aria-expanded="@showArchivedCourses"
            aria-controls="archived-courses-list">

        <span class="bi @(showArchivedCourses ? "bi-chevron-up" : "bi-chevron-down")"
              aria-hidden="true"></span>

        @(showArchivedCourses ? "Hide Archived" : "Show Archived")

    </button>

</div>


@if (!string.IsNullOrEmpty(archiveError))
{
    <p class="text-danger" role="alert">
        @archiveError
    </p>
}



@if (showArchivedCourses)
{
    <div id="archived-courses-list">

        @foreach (var course in courses.Where(c => c.IsArchived))
        {
            <CourseCard
                @key="course.Id"
                Course="course"
                OnRestore="RestoreCourse" />
        }

    </div>
}




@code {
    private bool showForm = false;
    private int? editingCourseId = null;

    private int? pendingDeleteId = null;
    private string deleteError = "";

    private Course newCourse = new()
    {
        Color = "#3b82f6"
    };

    private List<Course> courses = new();

    private string errorMessage = "";

    private string archiveError = "";

    private bool showArchivedCourses = false;




    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            courses = new();
            return;
        }


        courses = await CourseService.GetCoursesAsync(userId);

    }


    private void ToggleForm()
    {
        if(showForm)
        {
            showForm = false;
            ResetForm();
        }
        else
        {
            ResetForm();
            showForm = true;
        }
    }
    //this makes it so clicking cancel discards the changes
    //that are not saved.


    private async Task SaveCourse()
    {
        if (string.IsNullOrWhiteSpace(newCourse.Name))
        {
            errorMessage = "Course name is required.";
            return;
        }

        if (newCourse.Year < 2000 || newCourse.Year > 2100)
        {
            errorMessage = "Enter a year between 2000 and 2100.";
            return;
        }

        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "Please log in.";
            return;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            if (editingCourseId.HasValue)
            {
                // Updates an existing course
                var existingCourse = await db.Courses
                    .FirstOrDefaultAsync(c =>
                        c.Id == editingCourseId.Value &&
                        c.UserId == userId);

                if (existingCourse is null)
                {
                    errorMessage = "Course not found.";
                    return;
                }

                existingCourse.Name = newCourse.Name.Trim();
                existingCourse.Code = newCourse.Code;
                existingCourse.Instructor = newCourse.Instructor;
                existingCourse.Color = newCourse.Color;
                existingCourse.Semester = newCourse.Semester;
                existingCourse.Year = newCourse.Year;
            }
            else
            {
                // this creates a new course
                newCourse.Name = newCourse.Name.Trim();
                newCourse.UserId = userId;
                db.Courses.Add(newCourse);
            }

            await db.SaveChangesAsync();
        }

        ResetForm();
        showForm = false;

        await LoadCourses();
    }


    private void EditCourse(Course course)
    {
        editingCourseId = course.Id;

        newCourse = new Course
        {
            Name = course.Name,
            Code = course.Code,
            Instructor = course.Instructor,
            Color = course.Color,
            Semester = course.Semester,
            Year = course.Year
        };

        errorMessage = "";
        showForm = true;
    }


    private void ResetForm()
    {
        newCourse = new Course
        {
            Color = "#3b82f6",
            Semester = "Fall",
            Year = DateTime.Today.Year
        };

        editingCourseId = null;
        errorMessage = "";
    }

    private void AskToDelete(int courseId)
    {
        pendingDeleteId = courseId;
        deleteError = "";
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
        deleteError = "";
    }


    private async Task DeleteCourse(int courseId)
    {
        if (pendingDeleteId != courseId)
            return;

        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            deleteError = "Please log in.";
            return;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            var course = await db.Courses
                .Include(c => c.Assignments)
                .Include(c => c.Notes)
                .Include(c => c.Sessions)
                .FirstOrDefaultAsync(c =>
                    c.Id == courseId &&
                    c.UserId == userId);

            if (course is null)
            {
                deleteError = "Course not found.";
                return;
            }

            db.Assignments.RemoveRange(course.Assignments);
            db.Notes.RemoveRange(course.Notes);
            db.StudySessions.RemoveRange(course.Sessions);

            db.Courses.Remove(course);

            await db.SaveChangesAsync();
        }

        pendingDeleteId = null;
        deleteError = "";

        if (editingCourseId == courseId)
        {
            ResetForm();
            showForm = false;
        }

        await LoadCourses();
    }


    private Task ArchiveCourse(int courseId)
    {
        return SetArchiveStatus(courseId, true);
    }

    private Task RestoreCourse(int courseId)
    {
        return SetArchiveStatus(courseId, false);
    }


    private void ToggleArchivedCourses()
    {
        showArchivedCourses = !showArchivedCourses;
    }

    private async Task SetArchiveStatus(int courseId, bool isArchived)
    {
        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            archiveError = "Please log in.";
            return;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            var course = await db.Courses
                .FirstOrDefaultAsync(c =>
                    c.Id == courseId &&
                    c.UserId == userId);

            if (course is null)
            {
                archiveError = "Course not found.";
                return;
            }

            course.IsArchived = isArchived;

            await db.SaveChangesAsync();
        }

        archiveError = "";

        if (editingCourseId == courseId)
        {
            ResetForm();
            showForm = false;
        }

        await LoadCourses();
    }




}

